# Secrets: real environment files stay local. Templates (*.example, *.tmpl) are committed.
.env
.env.*
!.env.example
!.env.*.example

# Generated build and test output (never stage these with `git add -A`).
build/
node_modules/
test-results/
playwright-report/

# Local dev stack state (scripts/dev-up.sh)
/.dev-run/

# Helm local secrets (throwaway laptop values / optional local provider keys)
charts/creditmate/values-local-secrets.yaml
