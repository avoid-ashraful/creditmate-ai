{
  "uid": "creditmate-data-quality",
  "title": "Creditmate Data Quality (Extraction)",
  "description": "Per-bank extraction success, missing critical fields, confidence trend, OCR vs text. Reads the dq_monitor views in monitoring/sql/data_quality_views.sql.",
