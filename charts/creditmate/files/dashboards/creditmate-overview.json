    {
      "id": 19,
      "type": "timeseries",
      "title": "Signups (per hour)",
      "description": "Needs creditmate_signups_total from the backend. Not implemented yet.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 36,
        "w": 8,
