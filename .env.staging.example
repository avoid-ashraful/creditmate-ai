# Template for docker-compose.staging.yml. Copy to .env.staging (git-ignored) and fill every REPLACE_ME.
# Never commit .env.staging. Store the real values in your password manager or secret store.
# Hosts are compose service names, so the backend talks to postgres/redis/elasticsearch directly.

# --- images (set by the release process, immutable tags) ---
BACKEND_IMAGE=ghcr.io/avoid-ashraful/creditmate-ai-be:REPLACE_ME_IMAGE_TAG
FRONTEND_IMAGE=ghcr.io/avoid-ashraful/creditmate-ai-fe:REPLACE_ME_IMAGE_TAG

# --- Django ---
DJANGO_SETTINGS_MODULE=credit_mate_ai.settings
DJANGO_SECRET_KEY=REPLACE_ME_DJANGO_SECRET_KEY
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=staging.creditmate.ai,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://staging.creditmate.ai
LOG_LEVEL=INFO

# --- PostgreSQL (staging-only database) ---
POSTGRES_DB=creditmate_staging
POSTGRES_USER=creditmate
POSTGRES_PASSWORD=REPLACE_ME_POSTGRES_PASSWORD
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=creditmate_staging
DATABASE_USER=creditmate
DATABASE_PASSWORD=REPLACE_ME_POSTGRES_PASSWORD

# --- Redis (staging-only instance) ---
REDIS_PASSWORD=REPLACE_ME_REDIS_PASSWORD
REDIS_URL=redis://:REPLACE_ME_REDIS_PASSWORD@redis:6379/0
CELERY_BROKER_URL=redis://:REPLACE_ME_REDIS_PASSWORD@redis:6379/1

# --- Elasticsearch (staging-only cluster) ---
ELASTIC_PASSWORD=REPLACE_ME_ELASTIC_PASSWORD
ELASTICSEARCH_URL=http://elastic:REPLACE_ME_ELASTIC_PASSWORD@elasticsearch:9200
ELASTICSEARCH_PASSWORD=REPLACE_ME_ELASTIC_PASSWORD

# --- Error tracking ---
SENTRY_DSN=REPLACE_ME_SENTRY_DSN
